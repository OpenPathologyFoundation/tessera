            "specimenLabel": "Bone Marrow",
            "targetCount": 500,
            "requireCaseNumber": false,
            "upperRowAbnormal": false,
            "categories": {
                "upper": ["nrbc", "blasts", "pro", "myelo", "meta"],
                "lower": ["gran", "eos", "baso", "mono", "lymph"]
            },
            "outCodes": {
                "Z": "nrbc",
