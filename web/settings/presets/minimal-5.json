                "upper": ["neut", "lymph", "mono"],
                "lower": ["eos", "baso"]
            },
            "outCodes": {
                "F": "neut",
                "D": "lymph",
                "S": "mono",
                "A": "eos",
                "G": "baso"
            },
            "templates": [
                {
                    "tplCode": "std",
                    "tplName": "Standard",
                    "outSentence": "A {{total}}-cell differential count reveals: {{neut}}% neutrophils, {{lymph}}% lymphocytes, {{mono}}% monocytes, {{eos}}% eosinophils, and {{baso}}% basophils."
                }
            ],
            "constituents": {},
            "audio": { "enabled": true, "countSound": "click", "undoSound": "undo", "targetSound": "chime", "typewriterSound": "typewriter" },
            "autosave": true,
            "absoluteCounts": "optional",
            "handedness": "left",
            "morphologyChecklist": []
        }
    ]
}
