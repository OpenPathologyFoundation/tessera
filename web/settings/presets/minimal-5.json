{
    "version": "2.0",
    "profileId": "minimal-5",
    "profileName": "Minimal 5-Part",
    "description": "Simplified 5-part differential matching automated analyzer categories: neutrophils, lymphocytes, monocytes, eosinophils, basophils. Home-row only ergonomic keys.",
